# Macro file for visualization
# Use this for interactive mode to see the geometry

/run/initialize

# Open a viewer
/vis/open OGLIWin32 800x600-0+0

# Disable auto refresh and quieten vis messages
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw geometry
/vis/drawVolume

# Set view from the side to see the z-axis layout
/vis/viewer/set/viewpointVector 0 -1 0.3
/vis/viewer/set/upVector 0 0 1

# Zoom out to see the full 3.5m setup
/vis/viewer/zoom 0.4

# Specify style (wireframe to see inside)
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100

# Add axes to show scale
/vis/scene/add/axes 0 0 0 1 m

# Draw smooth trajectories at end of event
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2

# Let drawByCharge use its defaults (Positive=Blue, Neutral=Green, Negative=Red)

# FILTER: Show only elementary primary and secondary particles, dropping heavy nuclear fragments and neutrals
/vis/filtering/trajectories/create/particleFilter
/vis/filtering/trajectories/particleFilter-0/add proton

# To superimpose all events
/vis/scene/endOfEventAction accumulate

# Re-establish auto refreshing and verbosity
/vis/viewer/set/autoRefresh true
/vis/verbose warnings

# For testing, run a few particles
/gun/momentum 1.0
/run/beamOn 50